<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MindStack — a journal that reads your cognitive patterns</title>
<meta name="description" content="A journal that reads your cognitive patterns through MBTI, not just your words. Join the waitlist.">
<link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&display=swap" rel="stylesheet">

<!-- ═══════════════════════════════════════════════════════════════════
     GOOGLE ANALYTICS (GA4)
     Replace G-XXXXXXXXXX with your real Measurement ID (Admin > Data
     Streams > your stream > Measurement ID, in GA4).
     ═══════════════════════════════════════════════════════════════════ -->
<!-- Google tag (gtag.js) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-3L4Y2YZMB4"></script>
<script>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-3L4Y2YZMB4');
</script>

<style>
:root{--bg:#F7F5F0;--surface:#FFF;--surface2:#F0EDE6;--border:rgba(0,0,0,.08);--border2:rgba(0,0,0,.14);
--text:#1A1814;--text2:#6B6760;--text3:#9B9890;--purple:#5B4FD4;--purple-l:#EAE8FA;--purple-m:#9B94E8;
--green:#2D7A4F;--green-l:#E8F5EE;--r:14px;--rs:8px;}
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);min-height:100vh}
.serif{font-family:'DM Serif Display',serif}
.wrap{max-width:560px;margin:0 auto;padding:64px 24px 80px}
.logo{font-family:'DM Serif Display',serif;font-size:26px;margin-bottom:36px;text-align:center}
.hero h1{font-family:'DM Serif Display',serif;font-size:38px;line-height:1.2;text-align:center;margin-bottom:16px}
.hero p{font-size:16px;color:var(--text2);text-align:center;line-height:1.65;max-width:440px;margin:0 auto 36px}
.feature-row{display:flex;flex-direction:column;gap:10px;margin-bottom:40px}
.feature{background:var(--surface);border:.5px solid var(--border);border-radius:var(--r);padding:16px 18px;display:flex;gap:14px;align-items:flex-start}
.feature .icon{font-size:20px;flex-shrink:0;line-height:1}
.feature h3{font-size:14px;font-weight:500;margin-bottom:3px}
.feature p{font-size:13px;color:var(--text2);line-height:1.55}
.form-card{background:var(--surface);border:.5px solid var(--border);border-radius:var(--r);padding:26px 24px}
.form-card h2{font-family:'DM Serif Display',serif;font-size:22px;margin-bottom:6px;text-align:center}
.form-card .sub{font-size:13px;color:var(--text2);text-align:center;margin-bottom:20px}
#waitlist-form{display:flex;gap:8px}
#email-input{flex:1;border:.5px solid var(--border2);border-radius:var(--rs);padding:13px 14px;font-size:15px;font-family:'DM Sans',sans-serif;outline:none;background:var(--surface2);color:var(--text)}
#email-input:focus{border-color:var(--purple-m)}
#waitlist-form button{background:var(--purple);color:#fff;border:none;border-radius:var(--rs);padding:0 22px;font-size:15px;font-weight:500;font-family:'DM Sans',sans-serif;cursor:pointer;white-space:nowrap}
#waitlist-form button:hover{background:#4A3FC0}
#waitlist-form button:disabled{opacity:.5;cursor:not-allowed}
.msg{font-size:13px;text-align:center;margin-top:12px}
.msg.err{color:#C13030}
.msg.ok{color:var(--green)}
.success-state{display:none;text-align:center}
.success-state .check{width:44px;height:44px;border-radius:50%;background:var(--green-l);color:var(--green);display:flex;align-items:center;justify-content:center;font-size:22px;margin:0 auto 14px}
.success-state h2{font-family:'DM Serif Display',serif;font-size:20px;margin-bottom:6px}
.success-state p{font-size:13px;color:var(--text2)}
.footnote{font-size:12px;color:var(--text3);text-align:center;margin-top:22px}
@media (max-width:420px){#waitlist-form{flex-direction:column}}
</style>
</head>
<body>
<div class="wrap">
  <div class="logo">MindStack</div>

  <div class="hero">
    <h1>A journal that reads your cognitive patterns.</h1>
    <p>Not just what you wrote — how you actually process things. Built on MBTI cognitive functions, tuned to your specific type.</p>
  </div>

  <div class="feature-row">
    <div class="feature"><div class="icon">&#x270D;&#xFE0F;</div><div><h3>Journal, get insight</h3><p>Free write or walk through a situation step by step — get a short reflection tied to your actual wiring, not generic advice.</p></div></div>
    <div class="feature"><div class="icon">&#x1F465;</div><div><h3>Types in your life</h3><p>Notice who keeps coming up in your entries, and how the two of you actually tend to connect.</p></div></div>
    <div class="feature"><div class="icon">&#x1F4CA;</div><div><h3>Patterns over time</h3><p>Recurring themes, situations, and blind spots — surfaced from what you've actually written, not a static personality blurb.</p></div></div>
  </div>

  <div class="form-card">
    <div id="form-state">
      <h2 class="serif">Get early access</h2>
      <p class="sub">Building this now — leave your email and I'll let you know the moment it's live.</p>

      <!-- ═══════════════════════════════════════════════════════════
           FORMSPREE
           Replace YOUR_FORM_ID with the ID from your Formspree form
           (formspree.io → new form → copy the endpoint, it looks like
           https://formspree.io/f/abcdwxyz — the part after /f/ is the ID).
           ═══════════════════════════════════════════════════════════ -->
      <form id="waitlist-form" action="https://formspree.io/f/xzdnqgdr" method="POST">
        <input id="email-input" type="email" name="email" placeholder="you@email.com" required>
        <button type="submit" id="submit-btn">Notify me</button>
      </form>
      <div id="form-msg" class="msg"></div>
    </div>

    <div class="success-state" id="success-state">
      <div class="check">&#10003;</div>
      <h2 class="serif">You're on the list</h2>
      <p>I'll email you when MindStack is live. No spam before then.</p>
    </div>
  </div>

  <p class="footnote">No account needed to join the waitlist. Your email is only used to tell you when this launches.</p>
</div>

<script>
// Submits to Formspree via fetch so the page never reloads, and fires a
// GA4 event on success so you can see waitlist conversions in Analytics
// (Reports > Engagement > Events, or build a custom report).
var form = document.getElementById('waitlist-form');
var btn = document.getElementById('submit-btn');
var msg = document.getElementById('form-msg');

form.addEventListener('submit', function (e) {
  e.preventDefault();
  msg.textContent = '';
  msg.className = 'msg';
  btn.disabled = true;
  btn.textContent = 'Sending...';

  fetch(form.action, {
    method: 'POST',
    body: new FormData(form),
    headers: { 'Accept': 'application/json' }
  })
    .then(function (res) {
      if (res.ok) {
        document.getElementById('form-state').style.display = 'none';
        document.getElementById('success-state').style.display = 'block';
        if (typeof gtag === 'function') {
          gtag('event', 'sign_up', {
            method: 'waitlist',
            // Captures which UTM source drove this signup, if present
            // in the URL (e.g. ?utm_source=reddit).
            utm_source: new URLSearchParams(window.location.search).get('utm_source') || 'direct'
          });
        }
      } else {
        return res.json().then(function (data) {
          throw new Error((data.errors && data.errors[0] && data.errors[0].message) || 'Something went wrong.');
        });
      }
    })
    .catch(function (err) {
      msg.textContent = err.message || 'Could not submit right now — try again in a moment.';
      msg.className = 'msg err';
      btn.disabled = false;
      btn.textContent = 'Notify me';
    });
});

// Fires once per page load so GA shows you which channel (Reddit, Discord,
// etc.) is actually bringing people to the page, not just who signs up.
// This works automatically as long as you link out with UTM parameters
// (see notes below) — no code changes needed per channel.
if (typeof gtag === 'function') {
  gtag('event', 'landing_view', {
    utm_source: new URLSearchParams(window.location.search).get('utm_source') || 'direct',
    utm_medium: new URLSearchParams(window.location.search).get('utm_medium') || 'none'
  });
}
</script>
</body>
</html>
